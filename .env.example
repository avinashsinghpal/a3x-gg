# Environment variables — copy to .env.local (never commit real values)

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# URL of the Express backend deployed on Render
VITE_API_URL=https://your-render-service.onrender.com

# Supabase (keep for existing routes — do not remove)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Backend (server/) — set these in Render dashboard ─────────────────────
# Cloudflare account ID (from dash.cloudflare.com → right sidebar)
CF_ACCOUNT_ID=your_account_id

# D1 database ID (from Workers & Pages → D1 → your database)
CF_D1_DATABASE_ID=your_d1_database_id

# Cloudflare API token with D1 Edit permission
CF_API_TOKEN=your_cf_api_token

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:8080

# Port the Express server listens on (Render sets this automatically)
PORT=3001
